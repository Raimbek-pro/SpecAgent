{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Mode": "Auto",
    "Authority": "",
    "Audience": "specagent-api",
    "Issuer": "specagent-auth",
    "RequireHttpsMetadata": true
  },
  "PiiVault": {
    "TtlDays": 30
  },
  "Security": {
    "MaxUploadBytes": 26214400,
    "RateLimit": {
      "AuditPerMinute": 10,
      "AskPerMinute": 30
    },
    "Cors": {
      "AllowedOrigins": []
    }
  },
  "EventStore": "InMemory",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=specagent;Username=specagent;Password=specagent"
  },
  "Knowledge": {
    "Path": "../../knowledge"
  },
  "Embeddings": {
    "Model": "gemini-embedding-001"
  },
  "Qdrant": {
    "Host": "localhost",
    "Port": 6334
  },
  "Llm": {
    "Provider": "OpenAiCompatible",
    "Endpoint": "https://api.moonshot.ai/v1",
    "ApiKeyEnv": "MOONSHOT_API_KEY",
    "FallbackModel": "kimi-k3",
    "MaxConcurrency": 6,
    "MinDelayMs": 100
  },
  "ModelRouting": {
    "Default": { "Model": "kimi-k3", "Effort": "low" },
    "Agents": {
      "supervisor":     { "Model": "kimi-k3", "Effort": "low" },
      "logic":          { "Model": "kimi-k3", "Effort": "low" },
      "qa":             { "Model": "kimi-k3", "Effort": "low" },
      "compliance":     { "Model": "kimi-k3", "Effort": "low" },
      "distributed":    { "Model": "kimi-k3", "Effort": "low" },
      "checklist":      { "Model": "kimi-k3", "Effort": "low" },
      "meta-critic":    { "Model": "kimi-k3", "Effort": "low" },
      "patch-writer":   { "Model": "kimi-k3", "Effort": "low" },
      "patch-verifier": { "Model": "kimi-k3", "Effort": "low" }
    }
  },
  "Patches": {
    "MinSeverity": "Critical",
    "MaxPatches": 7,
    "MaxRounds": 2,
    "Parallelism": 6
  }
}
