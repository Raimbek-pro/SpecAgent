      "supervisor":     { "Model": "claude-opus-5-5",   "Effort": "medium" },
      "logic":          { "Model": "claude-sonnet-5-5", "Effort": "medium" },
      "qa":             { "Model": "claude-haiku-5-5",  "Effort": "low" },
      "compliance":     { "Model": "claude-sonnet-5-5", "Effort": "high" },
      "distributed":    { "Model": "claude-sonnet-5-5", "Effort": "high" },
      "meta-critic":    { "Model": "claude-opus-5-5",   "Effort": "high" },
      "patch-writer":   { "Model": "claude-sonnet-5-5", "Effort": "medium" },
      "patch-verifier": { "Model": "claude-opus-5-5",   "Effort": "medium" }
