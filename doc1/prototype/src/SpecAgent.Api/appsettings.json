{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "EventStore": "InMemory",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=specagent;Username=specagent;Password=specagent"
  },
  "Knowledge": {
    "Path": "../../knowledge"
  },
