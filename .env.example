# Copy to .env and fill in the required keys. Never commit .env!
POSTGRES_DB=specagent
POSTGRES_USER=specagent
POSTGRES_PASSWORD=specagent
POSTGRES_PORT=5432
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
API_PORT=5199

# LLM & Embedding API keys (set whichever provider is active)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
QWEN_API_KEY=

# Authentication & RBAC (Auto = Demo locally; set AUTH_AUTHORITY or JWT_SIGNING_KEY for strict JWT Bearer)
AUTH_MODE=Auto
AUTH_AUTHORITY=
AUTH_AUDIENCE=specagent-api
AUTH_ISSUER=specagent-auth
JWT_SIGNING_KEY=

# Encrypted PostgreSQL PII Vault (32-byte Base64 / 64-char hex / strong passphrase) & Security limits
PII_VAULT_KEY=
PII_VAULT_TTL_DAYS=30
MAX_UPLOAD_BYTES=26214400
RATE_LIMIT_AUDIT_PER_MIN=10
RATE_LIMIT_ASK_PER_MIN=30
